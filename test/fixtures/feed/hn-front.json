gs":["story","author_artninja1988","story_50233347","front_page"],"author":"artninja1988","children":[50233669,50233804,50233875,50233878,50233924,50233944,50234121,50234305,50234487,50234549,50234781,50236239],"created_at":"2026-10-25T16:31:21Z","created_at_i":1792945881,"num_comments":62,"objectID":"50233347","points":44,"story_id":50233347,"title":"A mathematician reads the AI future","updated_at":"2026-10-25T23:54:03Z","url":"https://www.theatlantic.com/ideas/2026/10/ai-math-human-future/689133/"},{"_highlightResult":{"author":{"matchLevel":"none","matchedWords":[],"value":"Brajeshwar"},"title":{"matchLevel":"none","matchedWords":[],"value":"Recreate the Apollo Guidance Computer"},"url":{"matchLevel":"none","matchedWords":[],"value":"https://www.raspberrypi.com/news/recreate-the-apollo-guidance-computer/"}},"_tags":["story","author_Brajeshwar","story_50195769","front_page"],"author":"Brajeshwar","children":[50235695,50236174,50236791,50236947],"created_at":"2026-10-22T14:21:17Z","created_at_i":1792678877,"num_comments":4,"objectID":"50195769","points":39,"story_id":50195769,"title":"Recreate the Apollo Guidance Computer","updated_at":"2026-10-25T23:46:32Z","url":"https://www.raspberrypi.com/news/recreate-the-apollo-guidance-computer/"},{"_highlightResult":{"author":{"matchLevel":"none","matchedWords":[],"value":"Gcarter08"},"story_text":{"matchLevel":"none","matchedWords":[],"value":"Hey HN, I\u2019m open sourcing my Hurston-1 narrowband TTS model (Apache-2.0). It is very good with American English and does especially well with Southern American and Regional African English accents. Destined AI is based in Atlanta, and I built this because I\u2019m amazed by what AI can do, and I wanted to help introduce and welcome more people to feel comfortable using and interacting with AI.<p>Since 2021, I\u2019ve been collecting fully consented voice data from over 20,000 people, 1M audio recordings, and over 1,800 hrs of audio captured to date. For this model, I used a small part of the data, 136 hrs, to finetune Maya1 and expand it\u2019s capabilities.<p>Hurston-1 is a narrowband TTS model that focuses the output on telephone use because that is still where most of these voices will be heard. I\u2019ve used it to support customers such as Amazon and Salesforce and generated over half-mill revenue with it. Now I\u2019m open sourcing it to help unlock opportunities for others as well.<p>Limitations: this model doesn\u2019t maintain the exact same voice across prompts and doesn\u2019t support voice cloning. For many use cases, this is fine but maybe not so - if you\u2019re creating podcasts.<p>This is the first release - I\u2019m already working on the next version with improvements.<p>I would appreciate, if anyone is interested in this space, download the model from huggingface, check it out and let me know any feedback. Also, open to connecting with others in this space as well."},"title":{"matchLevel":"none","matchedWords":[],"value":"Show HN: Hurston-1 open source TTS that speak Southern American and Afro-English"},"url":{"matchLevel":"none","matchedWords":[],"value":"https://huggingface.co/destined/hurston-1"}},"_tags":["story","author_Gcarter08","story_50227330","show_hn","front_page"],"author":"Gcarter08","children":[50227727,50235212,50235220,50235445,50235459,50236217,50236915,50236933],"created_at":"2026-10-25T01:30:13Z","created_at_i":1792891813,"num_comments":19,"objectID":"50227330","points":37,"story_id":50227330,"story_text":"Hey HN, I\u2019m open sourcing my Hurston-1 narrowband TTS model (Apache-2.0). It is very good with American English and does especially well with Southern American and Regional African English accents. Destined AI is based in Atlanta, and I built this because I\u2019m amazed by what AI can do, and I wanted to help introduce and welcome more people to feel comfortable using and interacting with AI.<p>Since 2021, I\u2019ve been collecting fully consented voice data from over 20,000 people, 1M audio recordings, and over 1,800 hrs of audio captured to date. For this model, I used a small part of the data, 136 hrs, to finetune Maya1 and expand it\u2019s capabilities.<p>Hurston-1 is a narrowband TTS model that focuses the output on telephone use because that is still where most of these voices will be heard. I\u2019ve used it to support customers such as Amazon and Salesforce and generated over half-mill revenue with it. Now I\u2019m open sourcing it to help unlock opportunities for others as well.<p>Limitations: this model doesn\u2019t maintain the exact same voice across prompts and doesn\u2019t support voice cloning. For many use cases, this is fine but maybe not so - if you\u2019re creating podcasts.<p>This is the first release - I\u2019m already working on the next version with improvements.<p>I would appreciate, if anyone is interested in this space, download the model from huggingface, check it out and let me know any feedback. Also, open to connecting with others in this space as well.","title":"Show HN: Hurston-1 open source TTS that speak Southern American and Afro-English","updated_at":"2026-10-25T23:53:34Z","url":"https://huggingface.co/destined/hurston-1"},{"_highlightResult":{"author":{"matchLevel":"none","matchedWords":[],"value":"endorphine"},"title":{"matchLevel":"none","matchedWords":[],"value":"Where the Romans Fought (interactive map)"},"url":{"matchLevel":"none","matchedWords":[],"value":"https://iosiflazaridis.github.io/battles-of-the-romans/"}},"_tags":["story","author_endorphine","story_50234879","front_page"],"author":"endorphine","children":[50236161,50236283,50236403,50236418,50236420,50236545,50236779,50236895],"created_at":"2026-10-25T18:58:14Z","created_at_i":1792954694,"num_comments":11,"objectID":"50234879","points":33,"story_id":50234879,"title":"Where the Romans Fought (interactive map)","updated_at":"2026-10-25T23:55:03Z","url":"https://iosiflazaridis.github.io/battles-of-the-romans/"},{"_highlightResult":{"author":{"matchLevel":"
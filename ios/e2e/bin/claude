#!/bin/sh
# Stand-in for Claude Code in sessions blimpd starts during the iPhone e2e test. It records its zmx
# session, pid and arguments in $E2E_DIR/claude.args, writes the status file Claude would (the resumed
# conversation's id after --resume, else a new one), then appends whatever it reads to $E2E_DIR/started.in.
# blimpd's naming and noting calls (src/names.ts, src/notes.ts: claude -p, the conversation on stdin) aren't
# sessions: naming gets a long-ish name for demo-quiz's conversation, to see how names fit on the phone, and
# none for the others; noting gets a question note for demo-chat's (so the inbox lists it under Waiting on you, read or not),
# and none for the others; a recap (src/recaps.ts) gets a card for demo-chat's, for the phone's recap drawer, and none
# for the others.
if [ "$1" = -p ]; then
  in=$(cat)
  case "$in" in
    *"Say where this Claude Code session stands"*"Add a dark mode toggle to settings"*) echo "QUESTION | should the toggle follow the system setting?" && exit 0 ;;
    *"Say where this Claude Code session stands"*) exit 1 ;;
    *"coming back to this Claude Code session"*"Add a dark mode toggle to settings"*)
      printf 'GOAL | A dark mode toggle in settings\nDONE | Toggle added to the Appearance section\nSTUCK | Waiting on you: decide if it follows the system setting\nNEXT | Add a test for the toggle\n' && exit 0 ;;
    *"Set up the test pipeline"*) echo "Configure Integration Test Pipeline Runs" && exit 0 ;;
  esac
  exit 1
fi
echo "$ZMX_SESSION $$ [$*]" >> "$E2E_DIR/claude.args"
sid=e2e00000-0000-0000-0001-$(printf %012d $$)
[ "$1" = --resume ] && sid=$2
mkdir -p "$CLAUDE_CONFIG_DIR/sessions"
printf '{"sessionId":"%s","cwd":"%s","status":"idle"}' "$sid" "$(pwd -P)" > "$CLAUDE_CONFIG_DIR/sessions/$$.json"
stty -icanon -echo
exec cat >> "$E2E_DIR/started.in"

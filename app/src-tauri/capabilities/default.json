{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the blimp UI may call in its own web views (main, and w-1, w-2... opened later; never the browser tabs' views, b-1, b-2...): only what it uses (docs/DESIGN.md, Content security policy).",
  "webviews": ["main", "w-*"],
  "permissions": [
    "allow-connect",
    "allow-disconnect",
    "allow-forward-port",
    "allow-unforward-port",
    "allow-update-server",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "allow-open-window",
    "allow-focus-project",
    "allow-drop-session",
    "allow-drag-hover",
    "allow-set-shown",
    "allow-focus-session",
    "allow-take-session",
    "allow-save-window-layout",
    "allow-restore-windows",
    "allow-download",
    "allow-upload",
    "allow-pick-upload",
    "allow-cancel-transfer",
    "opener:allow-reveal-item-in-dir",
    "allow-set-window-projects",
    "allow-set-viewing",
    "allow-claim-notice",
    "allow-browser-open",
    "allow-browser-bounds",
    "allow-browser-show",
    "allow-browser-go",
    "allow-browser-nav",
    "allow-browser-close",
    "allow-browser-read",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:window:allow-set-theme",
    "core:window:allow-set-badge-count",
    "core:window:allow-set-title",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    }
  ]
}

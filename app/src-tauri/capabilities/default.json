{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the blimp UI may call in its windows (main, and w-1, w-2... opened later): only what it uses (docs/DESIGN.md, Content security policy).",
  "windows": ["main", "w-*"],
  "permissions": [
    "allow-connect",
    "allow-disconnect",
    "allow-open-window",
    "allow-focus-project",
    "allow-drop-session",
    "allow-set-window-projects",
    "allow-set-viewing",
    "allow-claim-notice",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-badge-count",
    "core:window:allow-set-title",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    }
  ]
}
